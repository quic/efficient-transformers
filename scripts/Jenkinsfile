def testFilter(String profile) {
    switch (profile) {
        case 'dummy_layers_model':
            return '(not full_layers) and (not few_layers)'
        case 'few_layers_model':
            return '(not full_layers) and (not dummy_layers)'
        case 'full_layers_model':
            return '(not dummy_layers) and (not few_layers)'
        default:
            error "Unsupported TEST_PROFILE value: ${profile}"
    }
}

pipeline {
    agent { node { label params.NODE_LABEL } }

    options { disableConcurrentBuilds() }

    parameters {
        string(
            name: 'NODE_LABEL',
            defaultValue: 'qeff_node',
            description: 'Jenkins agent/node label to run this pipeline on'
        )
        choice(
            name: 'TEST_PROFILE',
            choices: [
                'dummy_layers_model',
                'few_layers_model',
                'full_layers_model'
            ],
            description: 'Select test profile'
        )
        string(
            name: 'SELECT_TEST_STAGES',
            defaultValue: 'ALL',
            description: 'Select which test stages you want to run (all run by default)'
        )
        choice(
            name: 'MODEL_TIER',
            choices: [
                'all',
                'priority',
                'legacy'
            ],
            description: 'Which model tier to test. all = full matrix (default); priority = only the actively-developed families declared in tests/configs/model_tiers.json; legacy = everything else. Edit that file to move a model between tiers.'
        )
        booleanParam(name: 'RUN_HL_APIS', defaultValue: true)
        booleanParam(name: 'RUN_QAIC_FEATURE', defaultValue: true)
        booleanParam(name: 'RUN_QAIC_EMBEDDING_AUDIO', defaultValue: true, description: 'Run text-embedding and audio (CTC / speech-seq2seq) model tests')
        booleanParam(name: 'RUN_QAIC_MM', defaultValue: true)
        booleanParam(name: 'RUN_QAIC_DIFFUSION', defaultValue: true)
        booleanParam(name: 'RUN_CLI', defaultValue: true)
        booleanParam(name: 'RUN_FINETUNE', defaultValue: false)
        booleanParam(name: 'RUN_DYNAMO_QAIC', defaultValue: true, description: 'Run dynamo on-QAIC compile/generate tests (torch 2.13)')
        string(
            name: 'QAIC_WORKERS',
            defaultValue: '4',
            description: 'Physical QAIC card count on the CI node. The device-bound execute passes derive their xdist worker count from this (cards / QEFF_QAIC_CARDS_PER_WORKER) so one worker owns each non-overlapping card slice. It is NOT a compile-parallelism knob -- raising it claims more cards than exist. Use MM_COMPILE_WORKERS for compile-phase parallelism.'
        )
        string(
            name: 'MM_COMPILE_WORKERS',
            defaultValue: '8',
            description: 'pytest-xdist worker count for the QAIC Multimodal compile-warm pass. That pass never touches an accelerator, so this is bounded by host CPU/RAM rather than by card count.'
        )
    }

    environment {
        TEST_FILTER = testFilter(params.TEST_PROFILE)
        QAIC_N      = "${params.QAIC_WORKERS}"
        MM_COMPILE_N = "${params.MM_COMPILE_WORKERS}"
        // Consumed by the tier hook in tests/conftest.py. Passed on each `docker exec`
        // rather than the `docker run` above, because the container is created in the
        // Install stage and `docker run -e` cannot carry a per-stage value.
        MODEL_TIER  = "${params.MODEL_TIER}"
    }

    stages {
        stage('Install QEfficient') {
            steps {
                sh '''
                    . ~/.bashrc
                    # Caches live on the node outside ${WORKSPACE}, so the deleteDir() in post
                    # cannot wipe them; only a dependency change re-downloads the wheels.
                    CI_CACHE_DIR="${CI_CACHE_DIR:-$HOME/.cache/qeff-ci}"
                    mkdir -p "$CI_CACHE_DIR/uv" "$CI_CACHE_DIR/pip"
                    
                    sudo docker run --privileged -dit --name ${BUILD_TAG} -e HF_TOKEN=${HF_TOKEN} \
                        -v ./:/efficient-transformers \
                        -v ${HF_PATH}:${DOCKER_HF_PATH} \
                        -v "$CI_CACHE_DIR/uv":/root/.cache/uv \
                        -v "$CI_CACHE_DIR/pip":/root/.cache/pip \
                        ${DOCKER_LATEST}:master_latest
                   
                    sudo docker exec ${BUILD_TAG} bash -ec "
                    cd /efficient-transformers
                    export UV_CACHE_DIR=/root/.cache/uv
                    export PIP_CACHE_DIR=/root/.cache/pip
                    
                    # Every dependency is a binary wheel, so the image needs only python3.12 with
                    # venv -- no toolchain, no headers -- which it normally already provides.
                    if ! python3.12 -c 'import venv' 2>/dev/null; then
                      apt-get update
                      DEBIAN_FRONTEND=noninteractive apt-get install -y tzdata python3.12-venv
                    fi
                    python3.12 -m venv preflight_qeff
                    . preflight_qeff/bin/activate
                    pip install uv==0.11.16
                    # One resolution pass. Split installs let a later one upgrade an already
                    # pinned dependency: librosa on its own replaced numpy 1.26.4 with 2.5.2.
                    uv pip install '.[test]' junitparser librosa==0.10.2 soundfile==0.13.1 timm==1.0.14 einops==0.8.1
                    # Overrides the qwen-vl-utils==0.0.8 pin for Qwen3-VL embedding tokenization,
                    # which needs process_vision_info(image_patch_size=...) from >=0.0.14. The two
                    # pins cannot co-resolve, hence a separate --no-deps pass; bumping the
                    # pyproject pin is the real fix and would remove this line.
                    uv pip install --no-deps qwen-vl-utils==0.0.14
                    rm -rf QEfficient"
                '''
            }
        }

        stage('HL API Tests') {
            when { expression { params.RUN_HL_APIS } }
            // Sequential, not parallel: Export & Compile is CPU-bound and now runs at -n auto,
            // claiming the whole host. QAIC LLM's own per-test export+compile (ahead of each
            // device-pinned execute) also needs host CPU, so running the two stages at once
            // would have both competing for the same cores.
            stages {
                stage('Export & Compile') {
                    steps {
                       timeout(time: params.TEST_PROFILE == 'full_layers_model' ? 0 : 60, unit: params.TEST_PROFILE == 'full_layers_model' ? 'HOURS' : 'MINUTES') {
                           sh '''
                           sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                           cd /efficient-transformers &&
                           . preflight_qeff/bin/activate &&
                           mkdir -p $PWD/Non_cli_qaic &&
                           export TOKENIZERS_PARALLELISM=false &&
                           export QEFF_HOME=$PWD/Non_cli_qaic &&
                           export TMPDIR=$PWD/.qeff_tmp/export_compile &&
                           rm -rf $PWD/.qeff_tmp/export_compile &&
                           mkdir -p $PWD/.qeff_tmp/export_compile &&
                           pytest tests -m '(not on_qaic) and (not finetune) and ${TEST_FILTER}' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline -n logical --junitxml=tests/tests_log1.xml --durations=10 &&
                           junitparser merge tests/tests_log1.xml tests/tests_log.xml &&
                           deactivate"
                           '''
                       }
                   }
                }

                stage('QAIC LLM') {
                    steps {
                        // -k excludes the bf16 compile-only variant: it now runs under Export &
                        // Compile instead (see its un-marking comment in test_causal_lm_models.py).
                        // It still carries the llm_model marker this stage selects on, so without
                        // the exclusion it would also collect here and redundantly recompile.
                        timeout(time: params.TEST_PROFILE == 'full_layers_model' ? 0 : 240, unit: params.TEST_PROFILE == 'full_layers_model' ? 'HOURS' : 'MINUTES') {
                            sh '''
                            sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                            cd /efficient-transformers &&
                            . preflight_qeff/bin/activate &&
                            mkdir -p $PWD/Non_qaic_llm &&
                            export TOKENIZERS_PARALLELISM=false &&
                            export QEFF_HOME=$PWD/Non_qaic_llm &&
                            export TMPDIR=$PWD/.qeff_tmp/qaic_llm &&
                            rm -rf $PWD/.qeff_tmp/qaic_llm &&
                            mkdir -p $PWD/.qeff_tmp/qaic_llm &&
                            export QEFF_NUM_QAIC_CARDS=${QAIC_N} &&
                            pytest tests -m '(llm_model) and (not qnn) and ${TEST_FILTER}' -k 'not test_per_pr_causal_bf16_subfunction_cb_ccl_compile_only' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline -n ${QAIC_N} --dist worksteal --junitxml=tests/tests_log2.xml --durations=10 &&
                            junitparser merge tests/tests_log2.xml tests/tests_log.xml &&
                            deactivate"
                            '''
                        }
                    }
                }

            }
        }
        stage('QAIC FEATURE') {
            when {expression { params.RUN_QAIC_FEATURE }}
            steps {
                timeout(time: params.TEST_PROFILE == 'full_layers_model' ? 0 : 120, unit: params.TEST_PROFILE == 'full_layers_model' ? 'HOURS' : 'MINUTES') {
                    sh '''
                    sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                    cd /efficient-transformers &&
                    . preflight_qeff/bin/activate &&
                    mkdir -p $PWD/Non_qaic_feature &&
                    export TOKENIZERS_PARALLELISM=false &&
                    export QEFF_HOME=$PWD/Non_qaic_feature &&
                    pytest tests -m '(on_qaic) and (feature) and (not multimodal) and (not qnn) and ${TEST_FILTER}' --ignore tests/transformers/sampler --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline --junitxml=tests/tests_log2_feature.xml --durations=10 &&
                    junitparser merge tests/tests_log2_feature.xml tests/tests_log.xml &&
                    deactivate"
                    '''
                }
            }
        }
        stage('QAIC Embedding & Audio') {
            when {expression { params.RUN_QAIC_EMBEDDING_AUDIO }}
            steps {
                timeout(time: params.TEST_PROFILE == 'full_layers_model' ? 0 : 120, unit: params.TEST_PROFILE == 'full_layers_model' ? 'HOURS' : 'MINUTES') {
                    sh '''
                    sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                    cd /efficient-transformers &&
                    . preflight_qeff/bin/activate &&
                    mkdir -p $PWD/Non_qaic_embedding_audio &&
                    export TOKENIZERS_PARALLELISM=false &&
                    export QEFF_HOME=$PWD/Non_qaic_embedding_audio &&
                    pytest tests -m '(embedding_audio_model) and (not qnn) and ${TEST_FILTER}' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline --junitxml=tests/tests_log_embedding_audio.xml --durations=10 &&
                    junitparser merge tests/tests_log_embedding_audio.xml tests/tests_log.xml &&
                    deactivate"
                    '''
                }
            }
        }
        stage('QAIC Multimodal') {
            when {expression { params.RUN_QAIC_MM }}
            steps {
                script {
                    if (params.TEST_PROFILE == 'full_layers_model') {
                        // Full, untruncated models stay on the single-phase serial path. The
                        // two-phase split below suppresses per-test cleanup, so peak disk becomes
                        // the sum of every QPC in the stage instead of a couple at a time -- fine
                        // for truncated models, not for full ones.
                        timeout(time: 0, unit: 'HOURS') {
                            sh '''
                            sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                            cd /efficient-transformers &&
                            . preflight_qeff/bin/activate &&
                            mkdir -p $PWD/Non_cli_qaic_multimodal &&
                            export TOKENIZERS_PARALLELISM=false &&
                            export QEFF_HOME=$PWD/Non_cli_qaic_multimodal &&
                            rm -f tests/tests_log6.xml &&
                            if [ -r /opt/qti-aic/versions/apps.xml ]; then echo 'QAIC Apps SDK version:'; cat /opt/qti-aic/versions/apps.xml; fi;
                            pytest tests -m '(multimodal) and (not qnn) and ${TEST_FILTER}' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline --ignore tests/transformers/models/reranker/test_reranker_mad.py --junitxml=tests/tests_log6.xml --durations=10;
                            test_status=\$?;
                            junitparser merge tests/tests_log6.xml tests/tests_log.xml;
                            merge_status=\$?;
                            deactivate;
                            if [ \$merge_status -ne 0 ]; then exit \$merge_status; fi;
                            exit \$test_status"
                            '''
                        }
                    } else {
                        // Two-phase compile/execute split (see tests/two_phase.py). Export+compile
                        // dominates each multimodal test's wall clock and needs no accelerator, so
                        // it runs first at MM_COMPILE_N workers -- far wider than the card count
                        // allows -- filling a shared content-addressed QEFF_HOME. The execute pass
                        // then re-runs the same tests against that warm cache, narrow enough to fit
                        // the cards. Previously the whole stage ran serially because every test
                        // drives dual-QPC generate(), where concurrent Program() creation across
                        // processes fails; only the compile-only subset was parallel.
                        //
                        // Both passes must share one QEFF_HOME for the second to hit the cache,
                        // which disables the session-start cache wipe and the per-worker QEFF_HOME
                        // remap. That makes the clean start this pipeline's responsibility, hence
                        // the rm -rf: the export hash covers the model config and compile options
                        // but not the QEfficient sources, so a directory left by an earlier build
                        // would serve stale QPCs to a PR that changed a modeling wrapper.
                        //
                        // The compile pass is best-effort: it writes no junit and its failures are
                        // swallowed, because the execute pass re-runs every test and reports the
                        // real result. A broken export/compile therefore still surfaces there,
                        // cold, exactly as it does today; the worst a compile-pass failure can do
                        // is forfeit the speedup.
                        //
                        // test_qwen3_vl_moe_disagg is excluded from the compile pass: it has not
                        // opted into resolve_two_phase_cleanup, so it would drive real hardware
                        // inside that wide pass. It runs cold in the execute pass instead. A new
                        // multimodal module must either opt in or be listed here.
                        env.MM_EXEC_N = Math.max(
                            1, Math.floorDiv(Integer.parseInt(params.QAIC_WORKERS.toString()), 2)
                        ).toString()
                        timeout(time: 90, unit: 'MINUTES') {
                            sh '''
                            sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                            cd /efficient-transformers &&
                            . preflight_qeff/bin/activate &&
                            rm -rf $PWD/Non_cli_qaic_multimodal &&
                            mkdir -p $PWD/Non_cli_qaic_multimodal &&
                            export TOKENIZERS_PARALLELISM=false &&
                            export QEFF_HOME=$PWD/Non_cli_qaic_multimodal &&
                            export QEFF_PER_PR_COMPILE_WARM_ONLY=1 &&
                            pytest tests -m '(multimodal) and (not qnn) and ${TEST_FILTER}' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline --ignore tests/transformers/models/reranker/test_reranker_mad.py --ignore tests/transformers/models/image_text_to_text/test_qwen3_vl_moe_disagg.py -n ${MM_COMPILE_N} --dist worksteal --durations=10 || true &&
                            deactivate"
                            '''
                        }
                        // Execute pass: authoritative, reports every test. QEFF_QAIC_CARDS_PER_WORKER=2
                        // because a dual-QPC VLM holds a vision and a language session at once and
                        // each is compiled at the default num_cores=16 -- a full card -- so one
                        // visible card per worker makes the second Program() fail.
                        timeout(time: 120, unit: 'MINUTES') {
                            sh '''
                            sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                            cd /efficient-transformers &&
                            . preflight_qeff/bin/activate &&
                            export TOKENIZERS_PARALLELISM=false &&
                            export QEFF_HOME=$PWD/Non_cli_qaic_multimodal &&
                            export QEFF_PER_PR_SHARED_HOME=1 &&
                            export QEFF_NUM_QAIC_CARDS=${QAIC_N} &&
                            export QEFF_QAIC_CARDS_PER_WORKER=2 &&
                            rm -f tests/tests_log6.xml &&
                            if [ -r /opt/qti-aic/versions/apps.xml ]; then echo 'QAIC Apps SDK version:'; cat /opt/qti-aic/versions/apps.xml; fi;
                            pytest tests -m '(multimodal) and (not qnn) and ${TEST_FILTER}' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline --ignore tests/transformers/models/reranker/test_reranker_mad.py -n ${MM_EXEC_N} --dist worksteal --junitxml=tests/tests_log6.xml --durations=10;
                            test_status=\$?;
                            junitparser merge tests/tests_log6.xml tests/tests_log.xml;
                            merge_status=\$?;
                            deactivate;
                            if [ \$merge_status -ne 0 ]; then exit \$merge_status; fi;
                            exit \$test_status"
                            '''
                        }
                    }
                }
            }
        }
        stage('QAIC Reranker Tests') {
            when { expression { params.RUN_QAIC_MM } }
            steps {
                timeout(time: 20, unit: 'MINUTES') {
                    sh '''
                    sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                    cd /efficient-transformers &&
                    . preflight_qeff/bin/activate &&
                    mkdir -p $PWD/Non_cli_qaic_reranker &&
                    export TOKENIZERS_PARALLELISM=false &&
                    export QEFF_HOME=$PWD/Non_cli_qaic_reranker &&
                    export QEFF_RERANKER_DOC_LIMIT=1 &&
                    pytest -q tests/transformers/models/reranker/test_reranker_mad.py --maxfail=1 --junitxml=tests/tests_log_reranker.xml --durations=10 &&
                    junitparser merge tests/tests_log_reranker.xml tests/tests_log.xml &&
                    deactivate"
                    '''
                }
            }
        }
        stage('QAIC Diffusion Models Tests') {
            when { expression { params.RUN_QAIC_DIFFUSION } }
            steps {
                timeout(time: 120, unit: 'MINUTES') {
                    sh '''
                    sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                    cd /efficient-transformers &&
                    . preflight_qeff/bin/activate &&
                    mkdir -p $PWD/Non_cli_qaic_diffusion &&
                    export TOKENIZERS_PARALLELISM=false &&
                    export QEFF_HOME=$PWD/Non_cli_qaic_diffusion &&
                    rm -rf /efficient-transformers/.qeff_tmp/qaic_diffusion &&
                    mkdir -p /efficient-transformers/.qeff_tmp/qaic_diffusion &&
                    export TMPDIR=/efficient-transformers/.qeff_tmp/qaic_diffusion &&
                    export HF_HUB_CACHE=/huggingface_hub &&
                    pytest tests -m 'diffusion_models' --ignore tests/vllm  --ignore tests/unit_test --ignore tests/nightly_pipeline --junitxml=tests/tests_log_diffusion.xml --durations=10 &&
                    junitparser merge tests/tests_log_diffusion.xml tests/tests_log.xml &&
                    deactivate"
                    '''
                }
            }
        }

        stage('CLI Tests') {
            when { expression { params.RUN_CLI } }
            steps {
                timeout(time: 120, unit: 'MINUTES') {
                    sh '''
                    sudo docker exec ${BUILD_TAG} bash -c "
                    #source /qnn_sdk/bin/envsetup.sh &&
                    #source /qnn_sdk/bin/envcheck -c &&
                    cd /efficient-transformers &&
                    . preflight_qeff/bin/activate &&
                    mkdir -p $PWD/cli &&
                    export TOKENIZERS_PARALLELISM=false &&
                    export QEFF_HOME=$PWD/cli &&
                    pytest tests -m '(cli and not qnn) and (not finetune)' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline --junitxml=tests/tests_log3.xml --durations=10 &&
                    junitparser merge tests/tests_log3.xml tests/tests_log.xml &&
                    deactivate"
                    '''
                }
            }
        }

        stage('QAIC DYNAMO') {
            when { expression { params.RUN_DYNAMO_QAIC } }
            steps {
                timeout(time: 240, unit: 'MINUTES') {
                    sh '''
                    sudo docker exec -e QEFF_MODEL_TIER=${MODEL_TIER} ${BUILD_TAG} bash -c "
                    cd /efficient-transformers &&
                    . preflight_qeff/bin/activate &&
                    pip install -r examples/dynamo/causal_lm/requirements.txt &&
                    mkdir -p \\$PWD/dynamo_qeff_qaic &&
                    export TOKENIZERS_PARALLELISM=false &&
                    export QEFF_HOME=\\$PWD/dynamo_qeff_qaic &&
                    pytest tests/dynamo -m '(dynamo) and (on_qaic) and ${TEST_FILTER}' --ignore tests/dynamo/nightly --dist loadgroup -n logical --junitxml=tests/tests_log_dynamo_qaic.xml --durations=10 &&
                    junitparser merge tests/tests_log_dynamo_qaic.xml tests/tests_log.xml &&
                    deactivate"
                    '''
                }
            }
        }

        stage('Finetune Tests') {
            when { expression { params.RUN_FINETUNE } }
            steps {
                timeout(time: 20, unit: 'MINUTES') {
                    sh '''
                    sudo docker exec ${BUILD_TAG} bash -c "
                    cd /efficient-transformers &&
                    . preflight_qeff/bin/activate &&
                    # TODO: Update torch_qaic path to py312 when migrating to Python 3.12
                    pip install /opt/qti-aic/integrations/torch_qaic/py312/torch_qaic-0.1.0-cp312-cp312-manylinux_2_34_x86_64.whl &&
                    # pip install /opt/qti-aic/integrations/torch_qaic/py310/torch_qaic-0.1.0-cp310-cp310-linux_x86_64.whl &&
                    pip install torch==2.9.1 torchvision==0.24.1 torchaudio==2.9.1 --index-url https://download.pytorch.org/whl/cpu &&
                    mkdir -p $PWD/cli_qaic_finetuning &&
                    export TOKENIZERS_PARALLELISM=false &&
                    export QEFF_HOME=$PWD/cli_qaic_finetuning &&
                    pytest tests -m '(finetune)' --ignore tests/vllm --ignore tests/unit_test --ignore tests/nightly_pipeline --junitxml=tests/tests_log_finetune.xml --durations=10 &&
                    junitparser merge tests/tests_log_finetune.xml tests/tests_log.xml &&
                    deactivate"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    sh '''
                    sudo chown -R ubuntu .
                    '''
                } catch (error) {
                    echo "Failed to change ownership: ${error}"
                }
            }
            script {
                try {
                    junit testResults: 'tests/tests_log.xml', allowEmptyResults: true
                } catch (error) {
                    echo "No test results file found or parsing failed: ${error}"
                }
            }
            script {
                try {
                    sh '''
                    python3 scripts/ci_report/generate_ci_report.py \
                        --xml-dir tests \
                        --output tests/ci_report.html \
                        --pr "${CHANGE_ID:-}" \
                        --commit "${GIT_COMMIT:-}" \
                        --branch "${BRANCH_NAME:-}" \
                        --profile "${TEST_PROFILE:-}" \
                        --build-url "${BUILD_URL:-}" || true
                    '''
                } catch (error) {
                    echo "CI report generation failed: ${error}"
                }
            }
            script {
                try {
                    archiveArtifacts artifacts: 'tests/ci_report.html, tests/tests_log*.xml',
                                     allowEmptyArchive: true,
                                     fingerprint: false
                } catch (error) {
                    echo "Artifact archiving failed: ${error}"
                }
            }
            script {
                try {
                    sh '''
                    sudo docker rm -f ${BUILD_TAG}
                    '''
                } catch (error) {
                    echo "Failed to delete container ${BUILD_TAG}: ${error}"
                }
            }
            echo 'Cleaning Workspace'
            deleteDir()
        }
    }
}
